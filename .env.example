# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

# Signs the session cookie (HS256). Required in production; at least 32 characters.
# Generate: openssl rand -base64 32
# In development it may be left empty: an ephemeral secret is used and sessions end on restart.
AUTH_SECRET=

# Google OAuth web client (Google Cloud Console → APIs & Services → Credentials).
# Leave both empty to run without Google: the button shows as unavailable and the demo still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin used to build the OAuth redirect URI (<APP_ORIGIN>/api/auth/google/callback).
# Optional: defaults to the origin of the incoming request.
APP_ORIGIN=http://localhost:3123

# ── Live investigations (/live) ─────────────────────────────────────────────
# A model key turns live runs on. Without one, /live says so and nothing runs (nothing is simulated instead).
# Claude API key (the team's setup): Claude Console → Settings → API keys, https://platform.claude.com/settings/keys
# Usage is billed to the key's account. Claude Opus 5.5 reasons; Claude Haiku 4.5 is the system under test.
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to a single workspace: the workspace id (wrkspc_…) from Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Alternative: a Gemini API key from Google AI Studio, https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional: anthropic | gemini. Default: whichever key is set, Claude first, then Gemini.
DIABLO_LLM=
# Optional model ids. Claude defaults: claude-opus-5-5 (reasoning) and claude-haiku-4-5 (target).
# The target must accept temperature 0.2: Claude 4.7 and later models (claude-haiku-5-5 included) reject it.
# Gemini defaults: gemini-3.8-flash and gemini-3.5-flash-lite.
DIABLO_REASONING_MODEL=
DIABLO_TARGET_MODEL=

# Optional budget, clamped to hard ceilings: experiments 2–3, items per arm 10–100, concurrency 1–8,
# timeouts 5–120 s (target) and 10–180 s (reasoning), run deadline 30–270 s. Empty means the default.
LIVE_MAX_EXPERIMENTS=
LIVE_MAX_ITEMS_PER_ARM=
LIVE_CONCURRENCY=
LIVE_TARGET_TIMEOUT_SECONDS=
LIVE_REASONING_TIMEOUT_SECONDS=
LIVE_RUN_DEADLINE_SECONDS=

# Abuse controls, kept in memory per server instance (best effort, reset on a cold start):
# model calls per UTC day, seconds between runs of one session, live runs at once.
LIVE_DAILY_CALL_CAP=500
LIVE_COOLDOWN_SECONDS=60
LIVE_MAX_CONCURRENT_RUNS=2
